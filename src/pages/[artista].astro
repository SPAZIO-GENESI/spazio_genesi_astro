---
import bioData from '../data/bio.js';

// Generazione statica delle pagine
export async function getStaticPaths() {
  return bioData.artisti.map((artist) => ({
    params: { artista: artist.cartella },
    props: { artist },
  }));
}

const { artist } = Astro.props;

// Nome artista
const nome = decodeURIComponent(artist.nome ?? "");

// Base path (compatibile GitHub Pages e dev)
const base = Astro.base ?? "/";

// Canonical sempre sul dominio ufficiale
const canonical = `https://spaziogenesi.org/biografie/bio.htm?artista=${artist.cartella}`;

// Recupero prima immagine per OG
let firstImg = null;
if (artist.img?.length) {
  const firstGroup = artist.img[0];
  const values = Object.values(firstGroup ?? {});
  if (values.length && values[0].length) firstImg = values[0][0].img ?? null;
}

const ogImage = firstImg
  ? `https://ogcdn.net/e4b8c678-7bd5-445d-ba03-bfaad510c686/v4/${encodeURIComponent(
      `Biografia ${nome}`
    )}/${encodeURIComponent(
      `Biografia Artista ${nome}`
    )}/${encodeURIComponent(
      `${base}biografie/${artist.cartella}/${firstImg}`
    )}/og.png`
  : null;

// Flatten immagini
const flatImages = [];
if (artist.img?.length) {
  for (const group of artist.img) {
    for (const images of Object.values(group)) {
      for (const image of images) flatImages.push(image);
    }
  }
}
---

