            <h1 id="biotit">Bio: {nome}</h1>
            <div id="bio" class="regdiv text-justify" set:html={artist.bio}></div>

            {artist.social && <p class="regdiv"><a href={artist.social} target="_blank" rel="noopener">{artist.social}</a></p>}
            {artist.IG && <p class="regdiv"><a href={`https://www.instagram.com/${artist.IG}`} target="_blank" rel="noopener">Instagram @{artist.IG}</a></p>}
            {artist.portfolio && <p class="regdiv"><a href={`${base}biografie/${artist.cartella}/${artist.portfolio}`} target="_blank" rel="noopener">{artist.portfolio}</a></p>}
          </div>

          <!-- IMMAGINI -->
          <div class="col-md-6 col-12 text-justify">
            {flatImages.map((image, index) => (
              <article class="mb-4" id={`img${index + 1}`}>

                {/* Immagine */}
                {image.img && (
                  <img
                    src={`${Astro.base ?? '/'}biografie/${artist.cartella}/${image.img}`}
                    alt={image.des ?? ""}
                    class="img-fluid w-100"
                    loading="lazy"
                  />
                )}

                {/* Descrizione lunga */}
                {image.deslunga && (
                  <p
                    class="regdiv text-justify mt-2"
                    set:html={image.deslunga}
