                  <img
                    src={Astro.base + 'biografie/' + artist.cartella + '/' + image.img}
                    alt={image.des ?? ""}
                    class="img-fluid w-100"
                    loading="lazy"
                  />
                )}

                {/* Descrizione lunga */}
                {image.deslunga && (
                  <p
                    class="regdiv text-justify mt-2"
